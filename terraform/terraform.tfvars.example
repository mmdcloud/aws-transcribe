# ==============================================================================
# Sample Terraform Configuration Variables
# Rename this file to terraform.tfvars or pass via -var-file=terraform.tfvars
# ==============================================================================

aws_region  = "us-east-1"
environment = "production"
project_name = "call-analytics"

# Optional overrides for resource names (leave blank for auto-generated names)
# raw_audio_bucket_name   = "my-company-callcenter-raw-audio"
# transcripts_bucket_name = "my-company-callcenter-transcripts"
# dynamodb_table_name     = "CallCenterAnalytics"

# Security & Encryption
use_kms_cmk                     = true
kms_key_deletion_window_in_days = 30

# Amazon Transcribe Settings
transcribe_language_code      = "en-US"
transcribe_enable_language_id = false
transcribe_max_speakers       = 5

# Amazon Bedrock Foundation Model
# Supported examples:
# - "anthropic.claude-3-haiku-20240307-v1:0" (fast, cost-effective, high quality)
# - "anthropic.claude-3-5-sonnet-20240620-v1:0" (in-depth reasoning, complex QA)
# - "amazon.nova-micro-v1:0"
bedrock_model_id    = "anthropic.claude-3-haiku-20240307-v1:0"
bedrock_max_tokens  = 2048
bedrock_temperature = 0.1

# Compute Sizing
dispatcher_lambda_memory  = 512
dispatcher_lambda_timeout = 60
processor_lambda_memory   = 1024
processor_lambda_timeout  = 300

# Queues & Fault Tolerance
sqs_ingestion_visibility_timeout  = 360
sqs_processing_visibility_timeout = 1800
sqs_max_receive_count             = 3
sqs_message_retention_seconds     = 864000  # 10 days
dlq_message_retention_seconds     = 1209600 # 14 days

# DynamoDB Configuration
dynamodb_billing_mode = "PAY_PER_REQUEST"
dynamodb_ttl_days     = 90

# Observability & Alerts
log_retention_in_days  = 30
create_alarm_sns_topic = true
alarm_email_endpoints  = [
  # "ops-alerts@yourcompany.com"
]

tags = {
  Architecture = "CallCenterAnalyticsPipeline"
  ManagedBy    = "Terraform"
  Department   = "CustomerExperience"
}

